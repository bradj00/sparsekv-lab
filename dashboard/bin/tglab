#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0
# SPDX-FileCopyrightText: Copyright 2026 sparsekv-lab contributors
"""tglab: update the TokenGate Lab follow-along dashboard state (www/state.json).

  tglab init                         write the plan (phases + estimates), keeps nothing
  tglab start <phase>                mark phase running (sets start time)
  tglab progress <phase> <pct> [note]
  tglab done <phase> [note]          100%, mark done
  tglab fail <phase> <note>          mark failed (stop condition)
  tglab skip <phase> <note>
  tglab log <text>                   append to the live log
  tglab find <title> <value> [good|bad|info]   add/update a finding card
  tglab verdict <text>

Sprint milestone cards (www/state.json -> sprint.milestones[]):
  tglab ms <id> <pct> [running|done|failed|pending] [note]   progress / status / note
  tglab msout <id> <good|partial|bad|neutral> "<outcome>" ["<detail>"]
                                     finish a milestone: status done (failed if result=bad),
                                     pct 100, ended now; outcome = one short plain line on the card,
                                     detail = longer popover text (\\n = line break)
  tglab mseta <id> <minutes>         estimated total minutes (card ETA = started + minutes,
                                     blended with measured rate once pct >= 10)
  tglab mswait <id> ["<text>"]       what a waiting milestone waits on (empty clears)
  e.g. tglab ms graphs 40 running "batch 3 captured"
       tglab mseta s128 60
       tglab msout graphs good "Yes: batch 3-4 ran on slow paths; fixed -> +38%" "Captured 1-4.\\nDecode 61 -> 84 tok/s"
"""
import json, os, sys, time, tempfile, fcntl

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
STATE = os.path.join(ROOT, "www", "state.json")

PLAN = [
    ("gpu", "Free a GPU", "The 3090 Ti keeps serving; the 3090 becomes the lab card", 5),
    ("env", "Install TokenGate", "Python 3.12 venv, PyTorch, TokenGate repo on the GPU host", 25),
    ("kernel", "Build the fast kernel", "FlashAttention-2 key-bias kernel compiled for the 3090 (sm_86, head dim 256)", 30),
    ("smoke", "Smoke test", "Released hybrid checkpoint (Qwen3.5-2B, needle task) at 32K: accuracy + prefill speedup", 20),
    ("agent", "KILL TEST: needed later?", "Reddit's main objection. Facts in early tool output, question asked turns later: does pruning lose them?", 60),
    ("prefix", "Prefix-cache fix", "Swap top-K for a fixed score cutoff: do keep decisions stay stable as context grows (= cacheable)?", 40),
    ("long", "Long context: 64K → 256K", "Does the gate hold up far beyond its 16K training? Accuracy, TTFT, memory per length", 40),
    ("verdict", "Projection + verdict", "Map results onto our 27B: agents per card, context per agent, decode gain, go/no-go", 20),
]

def load():
    try:
        return json.load(open(STATE))
    except Exception:
        return None

def save(s):
    s["updated"] = time.time()
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(STATE))
    with os.fdopen(fd, "w") as f:
        json.dump(s, f, indent=1)
    os.chmod(tmp, 0o644)
    os.replace(tmp, STATE)

def phase(s, pid):
    for p in s["phases"]:
        if p["id"] == pid:
            return p
    sys.exit(f"unknown phase {pid}")

def log(s, text, kind="info"):
    s["log"].append({"t": time.time(), "text": text, "kind": kind})
    s["log"] = s["log"][-300:]

def ms_get(s, mid):
    sp = s.get("sprint") or sys.exit("no sprint")
    return next((x for x in sp["milestones"] if x["id"] == mid), None) or sys.exit(f"unknown milestone {mid}")

def main(a):
    if not a:
        sys.exit(__doc__)
    cmd = a[0]
    if cmd == "init":
        plan, title, goal = PLAN, "TokenGate on dual 3090", "Can learned token pruning give us 2× the agents (or 2× the context) per 3090?"
        if len(a) > 1:                      # tglab init plan.json  -> {"title","goal","phases":[[id,name,desc,min],...]}
            j = json.load(open(a[1])); plan, title, goal = [tuple(x) for x in j["phases"]], j["title"], j["goal"]
        s = {"title": title, "goal": goal,
             "created": time.time(), "verdict": None, "findings": [], "log": [],
             "phases": [{"id": i, "name": n, "desc": d, "est_min": e, "status": "pending", "pct": 0, "note": "",
                         "started": None, "ended": None} for i, n, d, e in plan]}
        log(s, f"Plan written: {len(plan)} phases, ~{sum(x[3] for x in plan)/60:.1f} h estimated")
        save(s); return
    s = load() or sys.exit("run tglab init first")
    if cmd == "start":
        p = phase(s, a[1]); p.update(status="running", started=time.time(), ended=None, pct=max(p["pct"], 1))
        log(s, f"▶ {p['name']} started", "start")
    elif cmd == "progress":
        p = phase(s, a[1]); p["pct"] = float(a[2])
        if p["status"] == "pending":
            p.update(status="running", started=time.time())
        if len(a) > 3:
            note = " ".join(a[3:])
            if note != p.get("note"):          # only log a note when it actually changes
                p["note"] = note; log(s, f"{p['name']}: {note}")
    elif cmd in ("done", "fail", "skip"):
        p = phase(s, a[1]); note = " ".join(a[2:])
        p.update(status={"done": "done", "fail": "failed", "skip": "skipped"}[cmd], ended=time.time())
        if cmd == "done":
            p["pct"] = 100
        if not p["started"]:
            p["started"] = p["ended"]
        if note:
            p["note"] = note
        log(s, {"done": "✔", "fail": "✖", "skip": "⤼"}[cmd] + f" {p['name']}" + (f": {note}" if note else ""), cmd)
    elif cmd == "log":
        log(s, " ".join(a[1:]))
    elif cmd == "find":
        title, value = a[1], a[2]; kind = a[3] if len(a) > 3 else "info"
        s["findings"] = [f for f in s["findings"] if f["title"] != title] + [{"title": title, "value": value, "kind": kind, "t": time.time()}]
        log(s, f"Finding: {title} = {value}", "find")
    elif cmd == "ms":                       # sprint milestone: tglab ms <id> <pct> [running|done|failed|pending] [note]
        sp = s.get("sprint") or sys.exit("no sprint")
        m = next((x for x in sp["milestones"] if x["id"] == a[1]), None) or sys.exit(f"unknown milestone {a[1]}")
        m["pct"] = float(a[2]); st = a[3] if len(a) > 3 and a[3] in ("running", "done", "failed", "pending") else None
        if st: m["status"] = st
        elif m["status"] == "pending" and m["pct"] > 0: m["status"] = "running"
        if m["status"] == "done": m["pct"] = 100
        if m["status"] == "running" and not m.get("started"): m["started"] = time.time()
        if m["status"] in ("done", "failed") and not m.get("ended"): m["ended"] = time.time()
        note = " ".join(a[4:] if st else a[3:])
        if note and note != m.get("note"):
            m["note"] = note
        if st in ("done", "failed"):
            log(s, ("✔ Sprint milestone: " if st == "done" else "✖ Sprint milestone: ") + m["name"] + (f": {note}" if note else ""), st if st == "done" else "fail")
    elif cmd == "msout":                    # tglab msout <id> <good|partial|bad|neutral> "<outcome>" ["<detail>"]
        if len(a) < 4 or a[2] not in ("good", "partial", "bad", "neutral"):
            sys.exit(__doc__)
        m = ms_get(s, a[1]); now = time.time()
        m.update(result=a[2], outcome=a[3], pct=100, status="failed" if a[2] == "bad" else "done", ended=now)
        if len(a) > 4:
            m["detail"] = " ".join(a[4:]).replace("\\n", "\n")
        if not m.get("started"):
            m["started"] = now
        m.pop("waits_on", None)
        log(s, ("✖ " if a[2] == "bad" else "✔ ") + f"Sprint milestone: {m['name']}: {a[3]}", "fail" if a[2] == "bad" else "done")
    elif cmd == "mseta":                    # tglab mseta <id> <minutes>
        m = ms_get(s, a[1]); m["eta_min"] = float(a[2])
    elif cmd == "mswait":                   # tglab mswait <id> ["<text>"]
        m = ms_get(s, a[1]); t = " ".join(a[2:]).strip()
        if t: m["waits_on"] = t
        else: m.pop("waits_on", None)
    elif cmd == "exec":                     # plain-language executive status for phone updates
        s["exec"] = " ".join(a[1:])
    elif cmd == "verdict":
        s["verdict"] = " ".join(a[1:]); log(s, "Verdict: " + s["verdict"], "find")
    else:
        sys.exit(__doc__)
    save(s)

_lk = open(os.path.join(ROOT, ".state.lock"), "a")
fcntl.flock(_lk, fcntl.LOCK_EX)              # serialize read-modify-write across concurrent tglab calls
main(sys.argv[1:])
